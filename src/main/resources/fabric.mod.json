{
	"schemaVersion": 1,
	"id": "wavify",
	"version": "${version}",
	"name": "Wavify",
	"description": "Adds ambient tidal waves to beaches, oceans and rivers!",
	"authors": [
		"Superkat32"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/wavify-waves",
		"issues": "https://github.com/Superkat32/Wavify/issues",
		"sources": "https://github.com/Superkat32/Wavify"
	},
	"license": "MIT",
	"icon": "assets/wavify/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.superkat.wavify.Wavify"
		],
		"client": [
			"net.superkat.wavify.WavifyClient"
		],
		"modmenu": [
			"net.superkat.wavify.config.ModMenuInt"
		]
	},
	"mixins": [
		"wavify.mixins.json"
	],
	"accessWidener": "wavify.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"midnightlib": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
